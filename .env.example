# Copie ce fichier en .env (jamais commite) puis remplace les valeurs d'exemple.
# NODE_ENV=production active : cookies Secure, HSTS, refus des valeurs d'exemple et des bases locales.
NODE_ENV=development
PORT=3000

# Obligatoire en production (>= 32 caracteres aleatoires). Generer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changer APP_SECRET invalide toutes les sessions existantes.
APP_SECRET=remplace-moi-par-une-cle-longue-et-aleatoire

TURSO_DATABASE_URL=libsql://festiconnect-ehui-junior-christ.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=colle-ton-token-turso-ici
# Developpement/test sans Turso (refuse en production) :
# TURSO_DATABASE_URL=file:./festiconnect-dev.db

# Nombre de proxys de confiance devant l'application (Render/Koyeb : 1).
# 0 = X-Forwarded-For et X-Forwarded-Proto sont ignores.
TRUST_PROXY=0

# Origines autorisees pour les requetes mutantes (anti-CSRF), separees par des virgules.
# Vide = l'origine doit correspondre a l'en-tete Host de la requete.
# APP_ORIGIN=https://festiconnect.ci

# true = CSP envoyee en Content-Security-Policy-Report-Only (transition uniquement).
# CSP_REPORT_ONLY=false

# Commission de la plateforme sur les ventes de billets, en % (0 a 50, 0 par defaut).
# Deduite du solde que les organisateurs peuvent retirer en Mobile Money.
# PLATFORM_COMMISSION_PERCENT=0
