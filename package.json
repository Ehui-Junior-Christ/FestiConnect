{
  "name": "festiconnect",
  "version": "1.0.0",
  "description": "Plateforme SaaS evenementielle responsive pour le marche ivoirien et africain.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "start:prod": "node scripts/start-prod.js",
    "test": "node tests/register.test.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15"
  },
  "engines": {
    "node": ">=20"
  }
}
