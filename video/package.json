{
  "name": "festiconnect-video",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pipeline de rendu motion design FestiConnect (HTML/SVG pilote par timeline -> Playwright -> ffmpeg).",
  "scripts": {
    "analyze": "node scripts/analyze-audio.mjs",
    "sync": "node scripts/sync-timeline.mjs",
    "still": "node scripts/still.mjs",
    "serve": "node scripts/serve.mjs",
    "preview": "node scripts/render.mjs --preview",
    "render": "node scripts/render.mjs",
    "render:60fps": "node scripts/render.mjs --fps 60",
    "render:30s": "node scripts/render.mjs --timeline timeline-30s.json --out out/festiconnect_30s_1920x1080.mp4",
    "preview:30s": "node scripts/render.mjs --preview --timeline timeline-30s.json",
    "qc:qr": "node scripts/check-qr.mjs",
    "audio": "node scripts/build-audio.mjs",
    "verify": "node scripts/verify-final.mjs",
    "web": "node scripts/web-encode.mjs",
    "remux": "node scripts/remux-audio.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/sora": "5.3.0",
    "ffmpeg-static": "5.3.0",
    "playwright-core": "1.56.1",
    "qrcode-generator": "2.0.4"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "jsqr": "1.4.0",
    "pngjs": "7.0.0"
  }
}
